label = "the sealed dispatch"
spot_tag = &"dispatch"
required = true

[resource]
script = ExtResource("1_definition")
id = &"courier_dispatch"
title = "The courier's dispatch"
briefing = "A courier hid a sealed dispatch at the farmstead before he was taken. Soldiers now hold the farm. Find the dispatch and bring it out by the forest path or the south road."
objectives = Array[Resource]([SubResource("objective")])
exit_seconds = 5.0
enemy_groups = {"farm": 2}
rewards = {"parts": 2, "rubles": 60, "timber": 4}
area_name = "Farmstead"
