[resource]
script = ExtResource("1_definition")
id = &"winter_rations"
title = "Rations for the winter"
briefing = "Food for the camp was hidden for the winter in the old bunker or out in the bog. Patrols have been seen near the bunker. Find the rations and carry them out."
