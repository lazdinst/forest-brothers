required = true

[resource]
script = ExtResource("1_definition")
id = &"arena_dispatch"
title = "Combat arena: recover the dispatch"
briefing = "A sealed dispatch lies somewhere in the arena. Find it and leave by the forest path on the west edge."
objectives = Array[Resource]([SubResource("dispatch")])
exit_seconds = 5.0
time_limit_seconds = 3600.0
