; Open this file in Godot 4.7.2 standard edition.
config_version=5

[application]
config/name="Forest Brothers"
run/main_scene="res://scenes/prototype/camp_test.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}

crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
lean_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
lean_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
vault={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
pack_magazine={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
clear_jam={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
clean_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
dirty_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
inspect_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":73)]
}
reset_position={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":80)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.16, 0.19, 0.17, 1)
