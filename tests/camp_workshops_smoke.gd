extends SceneTree
const Runtime = preload("res://scripts/camp/camp_runtime.gd")
const Weapon = preload("res://scripts/weapons/prototype_weapon_state.gd")
var failures: Array[String] = []
func _initialize() -> void:
	call_deferred("_run")
func _check(ok: bool, detail: String) -> void:
	if not ok:
		failures.append(detail)
func _run() -> void:
	var camp = Runtime.new()
	var gun = Weapon.new()
	_check(camp.claim_cache() and not camp.claim_cache() and camp.stock.count(&"food")==8,"Quartermaster issues exactly one communal cache")
	var snapshot: Dictionary = camp.stock.quantities.duplicate()
	_check(not camp.stock.try_exchange({&"food":999,&"water":1},{}),"Shortage rejects transaction")
	_check(camp.stock.quantities==snapshot,"Failed exchange cannot partially spend")
	_check(camp.start_job(&"water",&"well","water"),"Well starts")
	camp.advance(2.1)
	_check(camp.stock.count(&"water")==8,"Well produces water once")
	_check(not camp.start_job(&"cook",&"cook","unassigned"),"Cooking requires assigned civilian")
	camp.assign_role(&"resident_01",&"cook")
	_check(camp.start_job(&"cook",&"cook","meal"),"Assigned cook starts meal")
	_check(not camp.start_job(&"cook",&"cook","meal"),"Duplicate request cannot spend twice")
	_check(not camp.assign_role(&"resident_01",&"builder"),"Busy worker cannot change jobs")
	_check(camp.assist(&"cook") and not camp.assist(&"cook"),"Foreman assistance applies once")
	camp.advance(2.1)
	camp.advance(10)
	_check(camp.stock.count(&"meals")==1 and camp.stock.count(&"food")==7,"Cook outputs once and spends once")
	_check(camp.feed_resident(&"resident_01") and not camp.feed_resident(&"resident_01"),"Food storage provisions resident without double spending")
	gun.cleanliness = 0.1
	gun.jammed = true
	camp.start_job(&"repair",&"armourer","repair",gun)
	camp.advance(3.1)
	_check(gun.cleanliness==1.0 and gun.jammed,"Armourer services condition without clearing jam")
	var combined: int = gun.total_rounds()+camp.stock.count(&"rounds")
	_check(camp.withdraw_ammo(gun) and camp.deposit_ammo(gun),"Ammo store supports both transfers")
	_check(gun.total_rounds()+camp.stock.count(&"rounds")==combined,"Ammo transfer conserves communal plus carried rounds")
	_check(not camp.start_job(&"recover",&"medical","early"),"Recovery does not erase untreated injuries")
	camp.start_job(&"bandage",&"medical","bandage")
	camp.advance(2.1)
	_check(not camp.patient.bleeding and camp.patient.fracture,"Bandage treats bleeding only")
	camp.start_job(&"splint",&"medical","splint")
	camp.advance(3.1)
	_check(not camp.patient.fracture,"Splint treats fracture")
	camp.start_job(&"recover",&"medical","recover")
	camp.advance(4.1)
	_check(camp.patient.recovery==0,"Medical post accelerates test-patient recovery")
	camp.assign_role(&"resident_01",&"builder")
	var timber: int = camp.stock.count(&"timber")
	camp.start_job(&"upgrade",&"shelter","cancel")
	_check(camp.cancel_job(&"shelter") and not camp.cancel_job(&"shelter"),"Cancel releases job once")
	_check(camp.stock.count(&"timber")==timber,"Cancelled job refunds reserved supplies once")
	camp.start_job(&"upgrade",&"shelter","upgrade")
	camp.advance(7.1)
	_check(camp.shelter_tier==1 and not camp.start_job(&"upgrade",&"shelter","repeat"),"Shelter upgrade occurs once")
	_check(not camp.place_plan(&"outside",Vector2(0,0)),"Planner rejects out-of-bounds footprint")
	_check(camp.place_plan(&"rack",Vector2(-10,4)) and not camp.place_plan(&"overlap",Vector2(-10,4)),"Planner validates overlap")
	camp.start_job(&"rack",&"rack","build_rack")
	camp.advance(6.1)
	_check(camp.plans[&"rack"].status==&"complete","Assigned builder completes placed plan")
	camp.start_job(&"dig",&"trench","dig")
	camp.advance(4.1)
	_check(camp.trench_complete,"Marked trench completes")
	camp.begin_exercise()
	camp.rescue(&"recruit_a")
	_check(not camp.residents.has(&"recruit_a"),"Departing civilian remains pending")
	camp.resolve_exercise(true)
	_check(camp.residents.has(&"recruit_a") and camp.quests_completed==0,"Early return secures recruit without completing quest")
	_check(not camp.resolve_exercise(true),"Repeated result cannot award duplicate arrivals")
	camp.begin_exercise()
	camp.rescue(&"recruit_b")
	camp.resolve_exercise(false)
	_check(not camp.residents.has(&"recruit_b") and camp.residents.has(&"recruit_a"),"Group death loses pending recruit, keeps established residents")
	camp.begin_exercise()
	camp.exercise_objective = true
	camp.resolve_exercise(true)
	_check(camp.quests_completed==1,"Objective completion awards the training reward once")
	for failure in failures:
		push_error(failure)
	if failures.is_empty():
		print("PASS: quartermaster, well, cook/food, armourer, ammo, distinct medical treatment, construction/cancel/assist, plans/trench, recruitment outcomes")
	quit(0 if failures.is_empty() else 1)
